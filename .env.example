APP_ENV=prod

# Database (PostgreSQL)
DB_USER=ai_lotto
DB_PASSWORD=

# JWT Secret (REQUIRED for production)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# JWT Token TTL (seconds)
JWT_TTL_SECONDS=21600
JWT_REFRESH_TTL_SECONDS=1209600

# CORS allowed origins (comma-separated)
FRONTEND_ORIGINS=https://yourdomain.com

# Frontend URL (OAuth redirect target)
FRONTEND_URL=https://yourdomain.com

# OAuth redirect base (backend public URL)
OAUTH_REDIRECT_BASE=https://api.yourdomain.com

# API URL (frontend build)
API_BASE_URL=https://api.yourdomain.com

# Time offset (seconds) for server clock drift
TIME_OFFSET_SECONDS=0

# SMS provider placeholders (fill after vendor selection)
SMS_PROVIDER=stub
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_SKIP_VERIFICATION=false

# Trusted proxy IPs (X-Forwarded-For)
TRUSTED_PROXIES=127.0.0.1

# Admin identifiers (optional; prefer is_admin on User)
ADMIN_IDENTIFIERS=
